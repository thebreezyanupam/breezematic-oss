# Optional. Every key below can be entered in the app instead (Settings > Keys), which
# is the easier way. Copy to .env only if you prefer files. Every value here has a
# default in src/config.ts; nothing is required
# to run `pnpm cli doctor`, `plan` or `validate`.

LOG_LEVEL=info

# Providers. Each stage picks its implementation from these.
LLM_PROVIDER=gemini
TTS_PROVIDER=kokoro
ALIGN_PROVIDER=whisper-cpp
FOOTAGE_PROVIDER=pexels

# Paid provider. Flash-Lite is the default because it keeps a video under $0.02.
GEMINI_API_KEY=
GEMINI_SCRIPT_MODEL=gemini-3.1-flash-lite

PEXELS_API_KEY=
FREESOUND_API_KEY=

# Pictures behind the type. 'stock' is openly licensed photography off Wikimedia
# Commons and costs nothing. 'ai' generates them with FLUX.1 [schnell], which is
# metered per image — six of them is about $0.018, so a video with generated
# pictures sits near the ceiling on its own. Raise COST_CEILING_USD or lower
# FLUX_IMAGES if that is not what you want.
IMAGE_SOURCE=stock
FLUX_API_KEY=
# Free generated pictures on Cloudflare Workers AI (about 130 a day on the free plan).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
FLUX_ENDPOINT=https://fal.run
FLUX_IMAGES=6

# schnell is the cheap one and the default. If the pictures are not accurate
# enough, the model is the lever — fal-ai/flux/dev renders the same prompt far
# more faithfully at $0.025 an image, which is ten times the cost. Change
# FLUX_USD_PER_IMAGE with it or the ledger will understate every video.
FLUX_MODEL=fal-ai/flux/schnell
FLUX_USD_PER_IMAGE=0.003

# Steps follow the model when left unset: 4 for schnell, 28 for anything else.
# FLUX_STEPS=

# Flux is trained around a megapixel; 864x1536 is exactly 9:16 and inside that
# range. Asking for the full 1080x1920 is where doubled horizons come from.
FLUX_WIDTH=864
FLUX_HEIGHT=1536

# Accounts, preferences and project history. Optional: without these the app
# runs exactly as it does otherwise, just with no sign-in. Videos are never
# uploaded. Use the anon/public key, never the service_role key.
# See supabase/README.md.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Publishing to YouTube. Optional: unset, nothing ever contacts Google and the
# MP4 just sits in out/. The OAuth client must be of type "Web application" and
# must list YOUTUBE_REDIRECT_URI verbatim. Unlike the Supabase key above, the
# client secret is a real secret. See youtube/README.md.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:4747/api/youtube/callback
# Only the value the publish form opens on; every upload is confirmed by hand.
YOUTUBE_PRIVACY=private
# 22 = People & Blogs, 27 = Education, 24 = Entertainment.
YOUTUBE_CATEGORY_ID=22

# Posting to a Facebook Page. Optional: unset, nothing ever contacts Meta. The
# app may stay in Development mode -- that is enough to post to a Page you
# admin; review is only needed to post to other people's Pages. The redirect
# must be listed under Facebook Login > Settings verbatim. Either value can
# instead be pasted into the app, which keeps them out of this file entirely.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:4747/api/facebook/callback
# Only what the post form opens on; every post is confirmed by hand. Unpublished
# puts the video on the Page without showing it to anyone.
FACEBOOK_PUBLISHED=false

# Local, free, no network at render time.
KOKORO_MODEL=onnx-community/Kokoro-82M-v1.0-ONNX
KOKORO_DTYPE=fp32
KOKORO_VOICE=af_heart
WHISPER_CPP_VERSION=1.7.6
WHISPER_MODEL=base.en

FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

COST_CEILING_USD=0.02

# Where `breezematic app` listens.
# The old KINETIC_* names still work; BREEZEMATIC_* wins if both are set.
BREEZEMATIC_APP_PORT=4747

# Directories, relative to the repo root.
BREEZEMATIC_WORK_DIR=work
BREEZEMATIC_OUT_DIR=out
BREEZEMATIC_CACHE_DIR=.cache
BREEZEMATIC_ASSETS_DIR=assets
